__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.provenlattice/
*.db

# Local benchmark checkout and generated temporary databases live outside this repository.
benchmark-repos/

# R1 raw agent artifacts remain local; top-level audited summaries are versioned explicitly.
experiments/retrieval-v1/results/T*/
experiments/retrieval-v1/results/_invalid*/
experiments/retrieval-v1/results/_attempts/

# R2 raw qualification cells remain local; reviewed aggregate reports are versioned.
experiments/retrieval-v2/results/T*/
experiments/retrieval-v2/results/_invalid*/

# R2.1 raw cells stay local; audited summaries and lifecycle reports are versioned.
experiments/retrieval-v2/r2_1/results/T*/

# R2.3 raw Agent cells stay local; manifests, aggregates, and reports are versioned.
experiments/retrieval-v2/r2_3/results/T*/

# SQI raw agent cells remain local; audited summaries, syntheses, and manifests are versioned.
experiments/query_interface_v1/results/formal/*/SQI-T*/
experiments/query_interface_v1/results/implementation-smoke/*/SQI-T*.json
# SQI quarantine artifacts (invalid agent session leftovers) remain local; the attribution review documents them.
experiments/query_interface_v1/results/formal/*/quarantine-*/

# Embedded ContextBench reference dataset clone (136MB parquet data) stays local per prereg.
experiments/context_bundle_v0/source/

# D8-RV1 per-run agent runtime homes (claude CLI session stores; over-long paths, raw stream already captured in agent-output.txt/events.ndjson)
experiments/analysis_layer/d8/results/D8-RV1-*/runs/*/home/
experiments/analysis_layer/d8/results/D8-RV1-*/runs/*/tmp/
